# Symbol map for STARTL.EXE (Screamer, low-res build), sha256 in reference/manifest.
# Addresses are flat addresses after tools/le/le2elf.py maps the LE objects at their
# preferred bases: code1 0x10000, data2 0xF0000, data3 0x100000.
#
# Format: see tools/ghidra/scripts/ApplySymbols.java.
#   <addr> f <name> [cc=<conv>] [sig=<prototype>] [; comment]
#   <addr> d|l <name> [type=<datatype>] [; comment]
# Default calling convention is __watcall (Watcom register: EAX, EDX, EBX, ECX, stack).
# Varargs functions use __cdecl (all arguments on the stack, caller pops).
#
# Naming: libc/runtime functions use their Watcom C library names; HMI SOS library
# functions use an hmi_ prefix (official API names where the use is certain); game code
# uses descriptive snake_case. A trailing "?" in a comment marks a guess.

# ---------------------------------------------------------------------------
# Watcom C runtime: startup / exit
# ---------------------------------------------------------------------------
0002feb8 f _cstart_                  ; DOS/4GW entry point (cstrt386): sets up PSP/env, zeroes BSS, runs __InitRtns, __CMain
0002ff30 f _cstart_body              ; part of _cstart_ split off by analysis
00030149 f __fatal_runtime_error     ; prints message to stdout via int 21h and exits
000d4064 f __CMain                   ; sets stack limits, calls main(argc, argv), then exit()
000d40b4 f __InitRtns                ; runs the XI initialiser table (priority ordered)
000d40ff f __FiniRtns                ; runs the YI finaliser table
0002fe7e f exit                     sig=void exit(int status)
0002fe96 f _exit
000e6468 f stackavail
000e6471 f __init_387_emulator?      ; sets 0x8000 flag
000ea061 f __STKOVERFLOW             ; "Stack Overflow!"
000e65f2 f __fp_not_loaded           ; "Floating-point support not loaded"
000e06cf f __fatal_error             ; debugger hook (int 3) else __fatal_runtime_error
0004d7b4 f __CHP                     ; truncate ST0 toward zero (float -> int)
0004d7e6 f __cos87
0004d7f0 f __sin87
0004d7fa f __fprem_reduce            ; FPREM argument reduction for fsin/fcos
0004d826 f cos
0004d832 f sin
0004d83e f __tan87
0004d843 f tan
000c1f9a f __atan87
000c1f9f f __atan2_87
000c1fa4 f atan
000c1df6 f __pow87
000c1f32 f pow
000c5b6e f __acos87?
000c5b92 f acos?
000c6a0e f sqrt
000c6a40 f __check_negative_domain   ; raises domain error for ST0 < 0
000de194 f __math_error              ; matherr dispatch
000dd67a f __exp87
000dd684 f exp?
000e6bdc f __emu387                  ; x87 emulator dispatcher (switch on opcode)

