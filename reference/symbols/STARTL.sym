000e0794 f __MemFree
000e089f f __unlink_heap_block
000e08de f __shrink_heap
000e0a3f f __link_heap_block
000e0ab3 f __last_free_size
000e0b01 f __expand_dpmi_heap
000e0bd4 f __adjust_amount
000e0c83 f __expand_heap
000e0dc7 f __heap_grow_size
000d1da6 f memcpy                   sig=void * memcpy(void *dst, void *src, unsigned int n)
000e033c f memcpy_ebx                ; memcpy with source in EBX (inline variant)
000d1c00 f memset                   sig=void * memset(void *dst, int c, unsigned int n)
000e0570 f __memset_bytes
000e05a7 f __memset_dwords

